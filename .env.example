# PostgreSQL Configuration
POSTGRES_DB=hims
POSTGRES_USER=hims_app
POSTGRES_PASSWORD=hims_dev_password
POSTGRES_PORT=5432

# Core Go Service (:8080)
CORE_GO_PORT=8080
DATABASE_URL=postgres://hims_app:hims_dev_password@localhost:5432/hims?sslmode=disable
JWT_SECRET=dev_insecure_jwt_secret_key_32bytes_long
INTERNAL_SERVICE_KEY=dev_internal_service_key_secret

# Python Interoperability Service (:8000)
INTEROP_PY_PORT=8000
CORE_SERVICE_URL=http://localhost:8080

# Frontend (:5173)
FRONTEND_PORT=5173
VITE_CORE_API_URL=http://localhost:8080
VITE_INTEROP_API_URL=http://localhost:8000
