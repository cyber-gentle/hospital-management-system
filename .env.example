# Copy this file to `.env` and fill in the two secrets below before running
# `docker compose up`. The services refuse to start without them, and both
# reject any of the development placeholders that previously appeared in this
# repository — see services/core-go/internal/config/config.go.

# --- Required secrets -------------------------------------------------------
# Generate each with the command shown; do not reuse the same value for both.
JWT_SECRET=          # openssl rand -base64 48   (min 32 bytes)
INTERNAL_SERVICE_KEY=  # openssl rand -base64 32   (min 16 bytes)

# --- PostgreSQL -------------------------------------------------------------
# Local development only. Use a real password for any deployed environment:
# postgres is published on the host port below.
POSTGRES_DB=hims
POSTGRES_USER=hims_app
POSTGRES_PASSWORD=hims_dev_password
POSTGRES_PORT=5432

# --- Core Go Service (:8080) ------------------------------------------------
CORE_GO_PORT=8080
# Only used when running the Go service directly on the host rather than via
# compose, which builds its own DATABASE_URL pointing at the `postgres` service.
DATABASE_URL=postgres://hims_app:hims_dev_password@localhost:5432/hims?sslmode=disable

# --- Python Interoperability Service (:8000) --------------------------------
INTEROP_PY_PORT=8000
CORE_SERVICE_URL=http://localhost:8080
# Browser origins allowed to call this service directly, comma-separated.
# Defaults to the Vite dev server when unset. Must never be "*": the service
# answers with credentials, so a wildcard would let any site make authenticated
# requests as a logged-in user. List the real origins for any deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (:5173) -------------------------------------------------------
FRONTEND_PORT=5173
VITE_CORE_API_URL=http://localhost:8080
VITE_INTEROP_API_URL=http://localhost:8000
